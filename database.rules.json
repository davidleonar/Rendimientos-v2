{
  "rules": {
    ".read": false,  
    ".write": false,
    
    "balances": {
      "$id": {
        ".read": "auth != null && $id === auth.uid",
        ".write": false
      }
    },
    
    "withdrawals": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",  
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "IntWithdrawals": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",  
        ".write": "auth != null && $uid === auth.uid"
      }
    }
  }
}