{
  "rules": {
    ".read": false,
    ".write": false,

    "balances": {
      "$id": {
      ".read": "auth != null && ($id === auth.uid || auth.uid === '5XgksHrgmyeGqqKFYGVjQVM0KGl1')",
      ".write": false
      }
    },

    "withdrawals": {
      ".read": "auth != null && auth.uid === '5XgksHrgmyeGqqKFYGVjQVM0KGl1'",  // Allow admin to read entire node
      ".write": "auth != null && auth.uid === '5XgksHrgmyeGqqKFYGVjQVM0KGl1'",  // Allow admin to write entire node
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",  // Users read own
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    "userSavings": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || auth.uid === '5XgksHrgmyeGqqKFYGVjQVM0KGl1')",
      "$txHash": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('userId').val() === $uid",
        }
      }
    }
  }
}