{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev": "next dev",
    "build": "next build && cp -r .next functions/.next",
    "manual-deposit": "node scripts/manual_deposit.js",
    "test-binance": "node scripts/test_binance_balance.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/functions-framework": "^5.0.5",
    "bitcoin-address-validation": "^2.2.3",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "next": "^15.5.23",
    "nodemailer": "^9.0.5",
    "twilio": "^4.23.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.5.0"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "^8.5.26",
      "ws": "^8.21.0",
      "uuid": "^11.1.1",
      "qs": "^6.15.2",
      "ts-deepmerge": "^8.0.0",
      "nodemailer": "^9.0.5",
      "protobufjs": "^7.6.5",
      "axios": "^1.18.0",
      "js-yaml": "^4.3.1",
      "brace-expansion": "^2.1.4",
      "websocket-driver": "^0.7.5",
      "@grpc/grpc-js": "^1.14.4",
      "form-data": "^4.0.6",
      "fast-uri": "^3.0.3",
      "nanoid": "^3.3.17",
      "sharp": "^0.35.0",
      "@babel/core": "^7.29.1",
      "body-parser": "^1.20.6"
    }
  }
}
