{
  "hosting": {
    "public": "my-spa/.next/server",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/lndProxy/**",
        "function": "lndProxy"
      },
      {
        "source":"**",
        "destination":"nextServer"
      }
      
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
