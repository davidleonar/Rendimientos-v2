{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "functions/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "**/*.php",
        "destination": "/404",
        "type": 301
      },
      {
        "source": "**/.git/**",
        "destination": "/404",
        "type": 301
      },
      {
        "source": "**/.env*",
        "destination": "/404",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/lndProxy/**",
        "function": "lndProxy"
      },
      {
        "source": "/api/tapdProxy/**",
        "function": "tapdProxy"
      },
      {
        "source": "/api/createInvoice",
        "function": "createInvoice"
      },
      {
        "source": "/api/checkInvoiceSettlement",
        "function": "checkInvoiceSettlement"
      },
      {
        "source": "/api/processLightningWithdrawal",
        "function": "processLightningWithdrawal"
      },
      {
        "source": "/api/processOnChainWithdrawal",
        "function": "processOnChainWithdrawal"
      },
      {
        "source": "/api/getNewDepositAddress",
        "function": "getNewDepositAddress"
      },
      {
        "source": "/api/createDepositIntent",
        "function": "createDepositIntent"
      },
      {
        "source": "/api/cancelDepositIntent",
        "function": "cancelDepositIntent"
      },
      {
        "source": "/_next/**",
        "function": "nextServer"
      },
      {
        "source": "**",
        "function": "nextServer"
      }
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|woff|woff2|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ]
}