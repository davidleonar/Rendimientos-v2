{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "functions/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/lndProxy/**",
        "function": "lndProxy"
      },
      {
        "source": "/_next/**",
        "function": "nextServer"
      },
      {
        "source": "**",
        "function": "nextServer"
      },
      {
        "source": "/api/tapdProxy/**",
        "function": "tapdProxy"
      }
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/favicon.ico",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "/(.*).css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime":"nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ]
}
