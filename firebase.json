{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "functions/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "**/*.php",
        "destination": "/404",
        "type": 301
      },
      {
        "source": "**/.git/**",
        "destination": "/404",
        "type": 301
      },
      {
        "source": "**/.env*",
        "destination": "/404",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/lndProxy/**",
        "function": "lndProxy"
      },
      {
        "source": "/api/tapdProxy/**",
        "function": "tapdProxy"
      },
      {
        "source": "/_next/**",
        "function": "nextServer"
      },
      {
        "source": "**",
        "function": "nextServer"
      }
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|woff|woff2|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ]
}